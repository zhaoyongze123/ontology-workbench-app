# 只放非敏感部署参数；数据库密码由 init-config 写入 deploy/private/。
PUBLIC_ORIGIN=https://ontology.example.com
HTTP_BIND_PORT=18083
IMAGE_PREFIX=ontology
IMAGE_TAG=replace-with-a-release-tag
# web 是 API 的唯一代理来源；数据库和宿主机均不在此代理信任范围内。
API_TRUSTED_PROXY_REGEX=172\.30\.0\.10
# 请替换为实际 HTTPS 网关连接到 web 端口时可见的来源网段。
EDGE_TRUSTED_PROXY_CIDRS=172.17.0.1/32
# 仅在私有 API 配置中补齐 Workbench client-id/client-secret 后设为 true。
WORKBENCH_OIDC_ENABLED=false
