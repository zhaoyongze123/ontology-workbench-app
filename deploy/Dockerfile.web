FROM node:22.23.4-alpine3.24@sha256:ce8d97f7cfc7c5386421eb932df20a29df99b1a7f469f6157d5c9956702ffadc AS build
WORKDIR /app
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci
COPY apps/web/ ./
RUN MULTIUSER_BUILD=1 npm run build

FROM nginx:1.27.5-alpine
RUN addgroup -S -g 10001 web && adduser -S -D -H -u 10001 -G web web \
    && mkdir -p /var/cache/nginx /var/run /tmp/nginx \
    && rm -f /etc/nginx/conf.d/default.conf \
    && chown -R 10001:10001 /var/cache/nginx /var/run /tmp/nginx /usr/share/nginx/html
COPY --from=build /app/dist-multiuser/ /usr/share/nginx/html/
COPY deploy/nginx.conf /etc/nginx/nginx.conf
COPY deploy/nginx-entrypoint.sh /docker-entrypoint.sh
RUN chmod 755 /docker-entrypoint.sh
USER 10001:10001
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8080/health || exit 1
ENTRYPOINT ["/docker-entrypoint.sh"]
