<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 容器日志统一写 stdout/stderr，由 Docker json-file 驱动按大小轮转。 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} requestId=%X{requestId} ::: %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>
    <root level="INFO"><appender-ref ref="CONSOLE"/></root>
    <logger name="org.springframework" level="INFO"/>
    <logger name="org.hibernate" level="INFO"/>
    <logger name="com.zaxxer.hikari" level="INFO"/>
    <logger name="druid.sql" level="OFF"/>
    <logger name="com.devin.ontology.mapper" level="WARN"/>
    <logger name="com.devin.ontology" level="INFO"/>
</configuration>
