# 构建基础环境
FROM postgres:16-bullseye AS builder

# 安装编译所需的依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    postgresql-server-dev-16 \
    ca-certificates \
    bison \
    flex \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp

# 安装pgvector插件
RUN git clone --branch v0.8.0 https://github.com/pgvector/pgvector.git \
    && cd pgvector \
    && make \
    && make install

# 安装age插件
RUN git clone https://github.com/apache/age.git \
    && cd age \
    && git checkout PG16 \
    && make \
    && make install

# 构建最终镜像
FROM docker.1ms.run/postgres:16-bullseye

# 设置元数据
LABEL maintainer="devin <wzh.devin@gmail.com>"
LABEL author="devin"
LABEL email="wzh.devin@gmail.com"
LABEL version="1.0.0"
LABEL description="support age and pgvector plugs"
LABEL vendor="意言科技（Tyrion AI）"

# 从构建阶段复制编译好的库文件 (.so)
COPY --from=builder /usr/lib/postgresql/16/lib/vector.so /usr/lib/postgresql/16/lib/
COPY --from=builder /usr/lib/postgresql/16/lib/age.so /usr/lib/postgresql/16/lib/
COPY --from=builder /usr/lib/postgresql/16/lib/bitcode/ /usr/lib/postgresql/16/lib/bitcode/

# 从构建阶段复制扩展的控制文件和 SQL 脚本
COPY --from=builder /usr/share/postgresql/16/extension/vector* /usr/share/postgresql/16/extension/
COPY --from=builder /usr/share/postgresql/16/extension/age* /usr/share/postgresql/16/extension/

# 创建初始化脚本，加载扩展
RUN echo "CREATE EXTENSION IF NOT EXISTS vector;" > /docker-entrypoint-initdb.d/00-init-extensions.sql && \
    echo "CREATE EXTENSION IF NOT EXISTS age;" >> /docker-entrypoint-initdb.d/00-init-extensions.sql && \
    echo "ALTER DATABASE postgres SET search_path = ag_catalog, \"\$user\", public;" >> /docker-entrypoint-initdb.d/00-init-extensions.sql

CMD ["postgres", "-c", "shared_preload_libraries=age"]
